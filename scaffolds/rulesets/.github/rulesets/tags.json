{
  "name": "tags",
  "target": "tag",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/tags/*"]
    }
  },
  "bypass_actors": [
    {
      "actor_type": "Team",
      "slug": "{{ .vars.ReleaseTeamSlug }}",
      "bypass_mode": "always"
    }
  ],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "required_signatures"
    }
  ]
}
